# =============================================================================
# Plantilla de variables de entorno para compose.yaml
# (archivo sin tildes a proposito, para evitar problemas de codificacion)
# =============================================================================
# 1. Copie este archivo con el nombre .env (en la misma carpeta):
#        Copy-Item .env.example .env
# 2. Reemplace el valor de ejemplo de MB_SESSION_SECRET_KEY por uno propio,
#    generado con PowerShell (32 bytes aleatorios en Base64). Vea el paso a
#    paso en docs/INSTALACION-SAMUEL.md.
# 3. NUNCA suba el archivo .env a GitHub (ya esta excluido en .gitignore).
# 4. Conserve el valor. Si lo cambia, se cierran todas las sesiones abiertas
#    (los datos NO se pierden; solo hay que volver a iniciar sesion).
#    Guardelo en un gestor de contrasenas personal, no en el repositorio.
# =============================================================================

# Clave para firmar las sesiones de Metabase. Minimo 16 caracteres.
# El valor de abajo es SOLO un marcador publico: reemplacelo.
MB_SESSION_SECRET_KEY=REEMPLAZAR_por_valor_generado_localmente

# Puerto local (opcional). Dejelo en 3000 salvo que ese puerto este ocupado.
# Si lo cambia, la URL sera http://localhost:<puerto> en toda la documentacion.
MB_PUERTO_LOCAL=3000

# -----------------------------------------------------------------------------
# Cuentas QA de SU instalacion de Metabase (las usan los scripts de pruebas).
# Docker Compose NO las pasa al contenedor: solo las leen los scripts.
# - Escriba sus propios valores; no copie los del companero.
# - Si una contrasena contiene espacios, el caracter $ o la secuencia " #",
#   escribala entre comillas simples:  QA_USER_PASSWORD='mi clave#1'
# - Compruebe las cuentas con:  .\scripts\probar-cuentas.ps1
# -----------------------------------------------------------------------------

# Administrador de Metabase
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Usuario normal ("Usuario QA", solo grupo Todos los usuarios)
QA_USER_EMAIL=
QA_USER_PASSWORD=