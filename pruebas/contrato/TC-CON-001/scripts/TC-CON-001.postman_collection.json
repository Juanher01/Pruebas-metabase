{
  "info": {
    "name": "TC-CON-001 - Presencia de campos esperados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/dashboard/{{dashboardId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Codigo HTTP 200 OK\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Content-Type es application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"El cuerpo es JSON valido\", () => { pm.response.json(); });",
              "pm.test(\"Respuesta en menos de 10 s\", () => pm.expect(pm.response.responseTime).to.be.below(10000));",
              "const d = pm.response.json();",
              "pm.test(\"Contiene los campos id y name\", () => { pm.expect(d).to.have.property(\"id\"); pm.expect(d).to.have.property(\"name\"); });",
              "pm.test(\"id corresponde al dashboard solicitado\", () => pm.expect(d.id).to.eql(parseInt(pm.variables.get(\"dashboardId\"), 10)));",
              "pm.test(\"name corresponde al dashboard solicitado (QA - Dashboard Principal)\", () => pm.expect(d.name).to.eql(\"QA - Dashboard Principal\"));",
              "const Ajv = require(\"ajv\"); const ajv = new Ajv({ allErrors: true });",
              "const schema = {\"type\":\"object\",\"required\":[\"id\",\"name\",\"description\",\"archived\",\"collection_id\",\"creator_id\",\"created_at\",\"updated_at\",\"entity_id\",\"auto_apply_filters\",\"parameters\",\"tabs\",\"dashcards\",\"can_write\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":[\"string\",\"null\"]},\"archived\":{\"type\":\"boolean\"},\"collection_id\":{\"type\":[\"integer\",\"null\"]},\"creator_id\":{\"type\":\"integer\"},\"created_at\":{\"type\":\"string\"},\"updated_at\":{\"type\":\"string\"},\"entity_id\":{\"type\":\"string\"},\"auto_apply_filters\":{\"type\":\"boolean\"},\"can_write\":{\"type\":\"boolean\"},\"parameters\":{\"type\":\"array\"},\"tabs\":{\"type\":\"array\"},\"dashcards\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"dashboard_id\",\"card_id\",\"row\",\"col\",\"size_x\",\"size_y\",\"parameter_mappings\",\"visualization_settings\",\"card\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"dashboard_id\":{\"type\":\"integer\"},\"card_id\":{\"type\":[\"integer\",\"null\"]},\"row\":{\"type\":\"integer\"},\"col\":{\"type\":\"integer\"},\"size_x\":{\"type\":\"integer\"},\"size_y\":{\"type\":\"integer\"},\"parameter_mappings\":{\"type\":\"array\"},\"visualization_settings\":{\"type\":\"object\"},\"card\":{\"type\":[\"object\",\"null\"]}}}}}};",
              "pm.test(\"Cumple el esquema del contrato (campos y tipos de v0.64.1)\", () => { const ok = ajv.validate(schema, pm.response.json()); pm.expect(ok, JSON.stringify(ajv.errors)).to.be.true; });",
              "pm.test(\"dashcards: 3 visualizaciones, todas con dashboard_id = id\", () => { pm.expect(d.dashcards).to.have.lengthOf(3); d.dashcards.forEach(c => pm.expect(c.dashboard_id).to.eql(d.id)); });",
              "pm.test(\"parameters: un filtro vinculado a las 3 tarjetas\", () => { pm.expect(d.parameters).to.have.lengthOf(1); d.dashcards.forEach(c => pm.expect(c.parameter_mappings.map(m => m.parameter_id)).to.include(d.parameters[0].id)); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Metabase-Session",
            "value": "{{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/{{dashboardId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "{{dashboardId}}"
          ]
        }
      }
    }
  ]
}