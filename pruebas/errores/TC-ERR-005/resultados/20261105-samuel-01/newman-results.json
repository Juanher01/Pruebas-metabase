        "id": "36c86f39-9f54-4d6b-b946-b842426474c0",
        "name": "GET /api/dashboard/{{dashboardPrivadoId}}",
        "request": {
          "url": {
            "path": [
              "api",
              "dashboard",
              "{{dashboardPrivadoId}}"
            ],
            "host": [
              "{{baseUrl}}"
            ],
            "query": [],
            "variable": []
          },
          "method": "GET"
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "e78223b4-b12d-41bd-8ca9-d514d804d126",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Variable dashboardPrivadoId definida\",()=>pm.expect(pm.variables.get(\"dashboardPrivadoId\")).to.not.be.oneOf([undefined,null,\"\",\"null\"]));",
                "pm.test(\"La solicitud no lleva cabecera de sesion\",()=>pm.expect(pm.request.headers.has(\"X-Metabase-Session\")).to.be.false);",
                "pm.test(\"Codigo HTTP 401 Unauthorized\",()=>pm.response.to.have.status(401));",
                "pm.test(\"No entrega datos del dashboard\",()=>{const t=pm.response.text();pm.expect(t).to.not.include(\"dashcards\");pm.expect(t).to.not.include(\"QA - Dashboard Restringido\");});",
                "pm.test(\"No hay error interno (la respuesta no es 5xx)\",()=>pm.expect(pm.response.code).to.be.below(500));",
                "pm.test(\"Respuesta en menos de 5 s\",()=>pm.expect(pm.response.responseTime).to.be.below(5000));",
                "pm.test(\"El cuerpo no expone trazas internas\",()=>pm.expect(pm.response.text()).to.not.match(/at (clojure|java|metabase).|Exception in/i));"
              ],
              "_lastExecutionId": "233e6a67-eafc-4d10-9b82-bd88f8a03a5b"
            }
          }
        ]
      }
    ],
